---
/**
 * Base layout: html/meta/OG, fonts, the pre-paint Motion script, the icon sprite, and the site chrome
 * (header, sticky navigation, footer).
 */
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/sections.css';
import '../styles/motion.css';
import Sprite from '../components/chrome/Sprite.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import { copyFor } from '../i18n';
import { AUTHOR, KEYWORDS, RELEASE, REPO, SITE_NAME, type Lang } from '../lib/site';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** the same page in the other language, for hreflang and the language switch */
  alternate: { en: string; ja: string };
  jsonLd?: Record<string, unknown>;
  /** a share image under /og/ (scripts/make-og.ts); defaults to the language's own */
  og?: string;
  noindex?: boolean;
}
const {
  lang,
  title,
  description,
  alternate,
  jsonLd,
  og = `/og/home-${lang}.png`,
  noindex = false,
} = Astro.props;
const copy = copyFor(lang);
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);
const ogUrl = new URL(og, Astro.site);
// One @graph per page: the site, its maker (same @id as the Moeko Works portfolio), the app, and this page.
const siteUrl = new URL('/', Astro.site).href;
const ids = { site: `${siteUrl}#website`, app: `${siteUrl}#himawari-studio`, author: AUTHOR.id };
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': ids.site,
      name: SITE_NAME,
      alternateName: ['Himawari Studio', 'Himawari visual novel engine'],
      url: siteUrl,
      inLanguage: ['en', 'ja'],
      keywords: KEYWORDS.join(', '),
      about: { '@id': ids.app },
      author: { '@id': ids.author },
      creator: { '@id': ids.author },
      publisher: { '@id': ids.author },
    },
    {
      '@type': 'Person',
      '@id': ids.author,
      name: AUTHOR.name,
      url: AUTHOR.url,
      jobTitle: 'Web developer',
      brand: { '@type': 'Brand', name: AUTHOR.brand },
      sameAs: AUTHOR.sameAs,
    },
    {
      '@type': 'SoftwareApplication',
      '@id': ids.app,
      name: 'Himawari Studio',
      alternateName: 'Himawari',
      description: copy.meta.description,
      applicationCategory: 'DesignApplication',
      applicationSubCategory: 'Visual novel engine',
      operatingSystem: 'Windows 10, Windows 11',
      softwareVersion: RELEASE.version,
      datePublished: RELEASE.publishedAt.slice(0, 10),
      downloadUrl: RELEASE.installer.url,
      fileSize: `${Math.round(RELEASE.installer.bytes / 1024 / 1024)} MB`,
      releaseNotes: RELEASE.notesUrl,
      url: siteUrl,
      image: ogUrl.href,
      inLanguage: ['en', 'ja'],
      isAccessibleForFree: true,
      license: `${REPO}#licenses`,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      sameAs: [REPO],
      author: { '@id': ids.author },
      creator: { '@id': ids.author },
      publisher: { '@id': ids.author },
    },
    {
      '@type': 'WebPage',
      name: title,
      description,
      url: canonical.href,
      inLanguage: lang,
      primaryImageOfPage: ogUrl.href,
      ...jsonLd,
      isPartOf: { '@id': ids.site },
      about: { '@id': ids.app },
      author: { '@id': ids.author },
    },
  ],
};
---

<!doctype html>
<html lang={lang} data-motion="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={`${AUTHOR.name} (${AUTHOR.brand})`} />
    <meta name="keywords" content={KEYWORDS.join(', ')} />
    <link rel="author" href={AUTHOR.url} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang="en" href={new URL(alternate.en, Astro.site).href} />
    <link rel="alternate" hreflang="ja" href={new URL(alternate.ja, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternate.en, Astro.site).href} />
    <meta name="theme-color" content="#FFFCF2" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Himawari Studio — free visual novel engine and editor for Windows"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <!-- Pre-paint Motion (WEBSITE.md §7.1): the saved choice, else prefers-reduced-motion. Its sha256 goes in the
         CSP (scripts/csp-hash.ts). ?still turns motion off for this visit without saving it. -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        let s = {};
        try {
          s = JSON.parse(localStorage.getItem('hws:prefs') || '{}');
        } catch {}
        const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.dataset.motion = /[?&]still\b/.test(location.search) ? 'off' : (s.motion ?? (rm ? 'off' : 'on'));
      })();
    </script>
    <Font cssVariable="--font-fredoka" preload />
    <link rel="stylesheet" href="/fonts/jp.css" media="print" data-jp-fonts />
    <noscript>
      <link rel="stylesheet" href="/fonts/jp.css" />
    </noscript>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip-link plain" href="#main">
      {copy.chrome.skip}
    </a>
    <Sprite />
    <Header alternate={alternate} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>
