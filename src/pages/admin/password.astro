---
/** /admin/password: change the password. Required at the first sign-in, before anything else. */
import Admin from '../../layouts/Admin.astro';
import { changePassword } from '../../server/auth';
import { requireAdmin, setSessionCookie } from '../../server/admin';
import { PASSWORD_MIN, type PolicyRule } from '../../server/password';

export const prerender = false;

const ctx = await requireAdmin(Astro, { allowPasswordChange: true });
if (ctx instanceof Response) return ctx;
const { db, session } = ctx;
const forced = session.user.mustChangePassword;

const RULES: Record<PolicyRule, string> = {
  min_length: `Use at least ${PASSWORD_MIN} characters.`,
  max_length: 'Use 128 characters or fewer.',
  contains_username: 'Don’t include your username.',
  same_as_current: 'Choose a password different from the current one.',
  guessable: 'Too easy to guess: it’s made only of common or site-related words.',
  leaked: 'This password has appeared in a data breach. Choose another.',
};
let errors: { current?: string; next?: string[]; confirm?: string } = {};
let done = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const result = await changePassword(db, session.user, {
    current: String(form.get('current') ?? ''),
    next: String(form.get('next') ?? ''),
    confirm: String(form.get('confirm') ?? ''),
  });
  if (result.ok) {
    setSessionCookie(Astro, result.token);
    if (forced) return Astro.redirect('/admin?done=password');
    done = true;
  } else {
    Astro.response.status = 422;
    errors = {
      current: result.current && 'The current password is incorrect.',
      next: result.next?.map((r) => RULES[r]),
      confirm: result.confirm && 'The two new passwords don’t match.',
    };
  }
}
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Admin title="Password" username={session.user.username}>
  <div class="admin-narrow">
    <h1>{forced ? 'Choose your own password' : 'Change your password'}</h1>
    {forced && (
      <p class="notice">
        You signed in with the temporary password from Vercel. Replace it now; after that, the temporary
        password stops working, and you can delete ADMIN_TEMP_PASSWORD from Vercel.
      </p>
    )}
    {done && (
      <p class="notice notice--ok" role="status">
        Password changed. Your other browsers have been signed out.
      </p>
    )}
    <form class="form" method="post">
      <label class="field">
        <span>{forced ? 'Temporary password' : 'Current password'}</span>
        <input
          name="current"
          type="password"
          autocomplete="current-password"
          required
          aria-invalid={errors.current ? 'true' : undefined}
          aria-describedby={errors.current ? 'err-current' : undefined}
        />
        {errors.current && (
          <span class="field-error" id="err-current">
            {errors.current}
          </span>
        )}
      </label>
      <label class="field">
        <span>New password</span>
        <input
          name="next"
          type="password"
          autocomplete="new-password"
          required
          minlength={PASSWORD_MIN}
          maxlength="128"
          aria-invalid={errors.next ? 'true' : undefined}
          aria-describedby="next-hint"
        />
        <small id="next-hint">
          At least {PASSWORD_MIN} characters. A few unrelated words make a good one. It’s checked against
          known breaches without sending the password anywhere.
        </small>
        {errors.next?.map((e) => (
          <span class="field-error">{e}</span>
        ))}
      </label>
      <label class="field">
        <span>New password again</span>
        <input
          name="confirm"
          type="password"
          autocomplete="new-password"
          required
          aria-invalid={errors.confirm ? 'true' : undefined}
        />
        {errors.confirm && <span class="field-error">{errors.confirm}</span>}
      </label>
      <div class="actions">
        <button class="btn btn--primary" type="submit">
          Change password
        </button>
      </div>
    </form>
  </div>
</Admin>
