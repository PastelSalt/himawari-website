---
/** The English home page (WEBSITE.md §5): one long page with anchored sections, in the mockup's order. */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsBar from '../components/chrome/NewsBar.astro';
import Ornament from '../components/ui/Ornament.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import Features from '../components/home/Features.astro';
import ComingSoon from '../components/home/ComingSoon.astro';
import Download from '../components/home/Download.astro';
import LinkCards from '../components/home/LinkCards.astro';
import News from '../components/home/News.astro';
import Faq from '../components/home/Faq.astro';
import { en as copy } from '../i18n/en';
import { RELEASE, REPO, SITE_NAME } from '../lib/site';

const lang = 'en';
const posts = (await getCollection('news', (p) => p.id.startsWith('en/')))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((p) => ({ ...p.data, href: p.data.link ?? `/news/${p.id.slice(3)}` }));
const latest = posts[0]!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Himawari Studio',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Windows 10, Windows 11',
  softwareVersion: RELEASE.version,
  datePublished: RELEASE.publishedAt.slice(0, 10),
  downloadUrl: RELEASE.installer.url,
  fileSize: `${Math.round(RELEASE.installer.bytes / 1024 / 1024)}MB`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: `${REPO}#licenses`,
  author: { '@type': 'Organization', name: 'Moeko Works', url: 'https://moekoworks.vercel.app' },
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: Astro.site?.href },
};
---

<Base
  lang={lang}
  copy={copy}
  title={copy.meta.title}
  description={copy.meta.description}
  alternate={{ en: '/', ja: '/ja' }}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <NewsBar label={copy.chrome.newsLabel} post={latest} />
    <Hero lang={lang} copy={copy.hero} />
    <Ornament />
    <About copy={copy.about} />
    <Ornament white />
    <Features copy={copy.features} />
  </div>
  <ComingSoon copy={copy.soon} />
  <div class="wrap">
    <Download lang={lang} copy={copy.download} label={copy.hero.download} />
    <Ornament />
    <LinkCards id="learn" title={copy.learn.title} items={copy.learn.items} />
    <Ornament white />
    <News lang={lang} copy={copy.news} posts={posts} />
    <Ornament />
    <Faq copy={copy.faq} />
    <Ornament white />
    <LinkCards id="involved" title={copy.involved.title} items={copy.involved.items} />
  </div>
</Base>
