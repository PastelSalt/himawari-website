---
/** Download: the button again, the requirements, the SmartScreen step, and the installer's SHA-256. */
import Button from '../ui/Button.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import ReleaseMeta from '../ui/ReleaseMeta.astro';
import Requirements from '../ui/Requirements.astro';
import SmartScreen from '../ui/SmartScreen.astro';
import { copyFor } from '../../i18n';
import { phrase } from '../../lib/phrase';
import { RELEASE, RELEASES_URL, langOf, path } from '../../lib/site';

const lang = langOf(Astro.url);
const copy = copyFor(lang);
const d = copy.download;
---

<section class="sec" id="download" aria-labelledby="t-download">
  <SectionTitle id="t-download" text={d.title} label={d.label} />
  <div class="dl">
    <div class="dl__main reveal">
      <h3 set:html={phrase(d.heading, lang)} />
      <p>{d.intro}</p>
      <p class="dl__phone">{d.phone}</p>
      <div class="hero__dl">
        <Button href={RELEASE.installer.url} icon="windows-logo" data-confetti aria-describedby="dl-meta">
          {copy.hero.download}
        </Button>
        <ReleaseMeta id="dl-meta" />
      </div>
      <p class="dl__links">
        <a href={path('/download', lang)}>{d.more}</a>
        <a href={RELEASE.notesUrl}>{d.notes}</a>
        <a href={RELEASES_URL}>{d.all}</a>
      </p>
    </div>
    <div class="dl__side reveal" style="--d:1">
      <Requirements />
      <SmartScreen />
    </div>
  </div>
</section>
