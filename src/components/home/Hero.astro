---
/** The first screen: what Himawari is, that it's free and for Windows, the download, and the live Studio window. */
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Flower from '../ui/Flower.astro';
import ReleaseMeta from '../ui/ReleaseMeta.astro';
import StudioScene from './StudioScene.astro';
import flowers from '../../assets/brand/flowers.png';
import { copyFor } from '../../i18n';
import { phrase } from '../../lib/phrase';
import { RELEASE, langOf } from '../../lib/site';

const lang = langOf(Astro.url);
const h = copyFor(lang).hero;
---

<section class="hero" aria-labelledby="hero-title">
  <Image src={flowers} alt="" width={74} densities={[1, 2]} class="drift drift--a" loading="eager" />
  <Flower class="drift drift--b" />
  <div class="hero__copy">
    <h1 id="hero-title" set:html={phrase(h.title, lang)} />
    <p class="hero__lead">{h.lead}</p>
    <div class="hero__actions">
      <div class="hero__dl">
        <Button href={RELEASE.installer.url} icon="windows-logo" data-confetti aria-describedby="hero-meta">
          {h.download}
        </Button>
        <ReleaseMeta id="hero-meta" />
      </div>
      <Button variant="ghost" href={h.firstGameHref} icon="book-open">
        {h.firstGame}
      </Button>
    </div>
  </div>
  <div class="hero__visual">
    <StudioScene />
    <p class="hero__note">{h.note}</p>
  </div>
</section>

<script>
  import '../../scripts/hero';
</script>
