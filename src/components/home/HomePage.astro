---
/** The home page (WEBSITE.md §5), in either language: one long page with anchored sections, in the mockup's order. */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsBar from '../chrome/NewsBar.astro';
import Ornament from '../ui/Ornament.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Features from './Features.astro';
import ComingSoon from './ComingSoon.astro';
import Download from './Download.astro';
import LinkCards from './LinkCards.astro';
import News from './News.astro';
import Faq from './Faq.astro';
import { copyFor } from '../../i18n';
import { newsPosts } from '../../lib/news';
import { type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = copyFor(lang);
const posts = newsPosts(await getCollection('news'), lang);

// the page node; Base adds the WebSite, maker and app (Himawari Studio) nodes around it
const jsonLd = { mainEntity: { '@id': `${new URL('/', Astro.site).href}#himawari-studio` } };
---

<Base
  lang={lang}
  title={copy.meta.title}
  description={copy.meta.description}
  alternate={{ en: '/', ja: '/ja' }}
  jsonLd={jsonLd}
>
  <div class="wrap">
    {posts[0] && <NewsBar post={posts[0]} />}
    <Hero />
    <Ornament />
    <About />
    <Ornament white />
    <Features />
  </div>
  <ComingSoon />
  <div class="wrap">
    <Download />
    <Ornament />
    <LinkCards id="learn" section={copy.learn} />
    <Ornament white />
    <News posts={posts} />
    <Ornament />
    <Faq />
    <Ornament white />
    <LinkCards id="involved" section={copy.involved} />
  </div>
</Base>
