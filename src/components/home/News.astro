---
/** The latest three news posts as rows (nanahira.jp's news list), then a wide pale-yellow "All news" button. */
import Button from '../ui/Button.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import NewsRows from '../ui/NewsRows.astro';
import { copyFor } from '../../i18n';
import type { Post } from '../../lib/news';
import { langOf, path } from '../../lib/site';

interface Props {
  posts: Post[];
}
const lang = langOf(Astro.url);
const n = copyFor(lang).news;
---

<section class="sec" id="news" aria-labelledby="t-news">
  <SectionTitle id="t-news" text={n.title} label={n.label} />
  <NewsRows posts={Astro.props.posts.slice(0, 3)} />
  <Button variant="wide" href={path('/news', lang)}>
    {n.all}
  </Button>
</section>
