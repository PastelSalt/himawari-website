---
/**
 * The header (logo, language, Motion, GitHub, contact) and the sticky navigation row: "HIMAWARI", a thin rule,
 * and the home page's sections. On phones the links fold into the yellow menu button, a popover that needs no
 * script to open or close.
 */
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import logo from '../../assets/brand/himawari-studio.png';
import { CONTACT_URL, REPO, type Lang } from '../../lib/site';
import type { Copy } from '../../i18n/en';

interface Props {
  lang: Lang;
  copy: Copy;
  alternate: { en: string; ja: string };
}
const { lang, copy, alternate } = Astro.props;
const c = copy.chrome;
const home = lang === 'ja' ? '/ja' : '/';
// on the home page the links are plain anchors; elsewhere they go back to the home page's sections
const isHome = Astro.url.pathname.replace(/\/+$/, '') === home.replace(/\/$/, '');
const href = (id: string) => (isHome ? `#${id}` : `${home === '/' ? '' : home}/#${id}`);
---

<header class="top">
  <div class="wrap top__row">
    <a class="top__logo plain" href={home}>
      <Image src={logo} alt={c.logoAlt} height={64} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </a>
    <div class="top__tools">
      <p class="lang">
        <span class="sr-only">{c.langLabel}: </span>
        {lang === 'en' ? (
          <>
            <b aria-current="true">EN</b> /{' '}
            <a class="plain" href={alternate.ja} hreflang="ja" lang="ja">
              日本語
            </a>
          </>
        ) : (
          <>
            <a class="plain" href={alternate.en} hreflang="en" lang="en">
              EN
            </a>{' '}
            / <b aria-current="true">日本語</b>
          </>
        )}
      </p>
      <button
        class="motion"
        type="button"
        aria-pressed="true"
        data-motion-toggle
        data-on={c.motionOn}
        data-off={c.motionOff}
      >
        <Icon name="sparkle" />
        <span class="motion__text" data-motion-text>
          {c.motionOn}
        </span>
      </button>
      <a class="icon-btn plain" href={REPO} aria-label={c.github} rel="noopener">
        <Icon name="github-logo" />
      </a>
      <a class="icon-btn plain" href={CONTACT_URL} aria-label={c.contact} rel="noopener">
        <Icon name="envelope-simple" />
      </a>
    </div>
  </div>
</header>

<nav class="nav" aria-label={c.navLabel}>
  <div class="wrap nav__row">
    <a class="nav__name plain" href={isHome ? '#main' : home}>
      HIMAWARI
    </a>
    <span class="nav__rule" aria-hidden="true"></span>
    <ul class="nav__links" role="list">
      {c.nav.map((n) => (
        <li>
          <a class="plain" href={href(n.id)}>
            {n.label}
          </a>
        </li>
      ))}
    </ul>
    <button class="menu" type="button" popovertarget="menu" aria-label={c.menu}>
      <Icon name="list" />
    </button>
  </div>
</nav>

<div class="menu-panel" id="menu" popover>
  <button class="menu-panel__close icon-btn" type="button" popovertarget="menu" popovertargetaction="hide">
    <Icon name="x" label={c.close} />
  </button>
  <ul role="list">
    {c.nav.map((n) => (
      <li>
        <a class="plain" href={href(n.id)} data-menu-link>
          {n.label}
        </a>
      </li>
    ))}
  </ul>
  <p class="menu-panel__lang">
    {lang === 'en' ? (
      <a class="plain" href={alternate.ja} hreflang="ja" lang="ja">
        日本語
      </a>
    ) : (
      <a class="plain" href={alternate.en} hreflang="en" lang="en">
        English
      </a>
    )}
  </p>
</div>
