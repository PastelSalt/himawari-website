# Copy to .env.local and fill in. Real values live only in Vercel and .env.local, never in git.

# --- Site
SITE_URL=http://localhost:4321

# --- Build: optional, raises the GitHub API rate limit when reading the latest release
GITHUB_TOKEN=

# --- Database (Neon, through the Vercel Marketplace integration). Local: point at a dev branch.
DATABASE_URL=postgresql://...-pooler.../neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://.../neondb?sslmode=require

# --- Security
CRON_SECRET=                        # random; Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes

# --- Admin panel (/admin). The owner account is created from these at the first sign-in, which then asks for a
# new password; after that they are ignored and can be deleted from Vercel.
ADMIN_USERNAME=
ADMIN_TEMP_PASSWORD=
# A Vercel deploy hook for the main branch: saving news rebuilds the site through it
VERCEL_DEPLOY_HOOK_URL=

# --- Alerts
DISCORD_WEBHOOK_URL=
